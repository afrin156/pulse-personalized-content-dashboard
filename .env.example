# Copy this file to .env.local and fill in the keys you have.
# The app works WITHOUT any keys: it falls back to built-in sample data.
# Keys are only read on the server (API route handlers) and never reach the browser.

# https://newsapi.org  (free developer key)
NEWS_API_KEY=

# https://www.themoviedb.org/settings/api  (v3 "API Key")
TMDB_API_KEY=
